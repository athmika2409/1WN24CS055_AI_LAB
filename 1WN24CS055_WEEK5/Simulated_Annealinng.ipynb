      "source": [
        "import math\n",
        "import random\n",
        "\n",
        "def calculate_cost(state):\n",
        "    cost = 0\n",
        "    n = len(state)\n",
        "    for i in range(n):\n",
        "        for j in range(i + 1, n):\n",
        "            if state[i] == state[j] or abs(state[i] - state[j]) == abs(i - j):\n",
        "                cost += 1\n",
        "    return cost\n",
        "\n",
        "def get_random_neighbor(state):\n",
        "    neighbor = list(state)\n",
        "    col = random.randint(0, len(state) - 1)\n",
        "    new_row = random.randint(0, len(state) - 1)\n",
        "    while new_row == state[col]:\n",
        "        new_row = random.randint(0, len(state) - 1)\n",
        "    neighbor[col] = new_row\n",
        "    return neighbor\n",
        "\n",
        "def simulated_annealing(n=8, initial_temp=100.0, cooling_rate=0.99, max_iterations=50000):\n",
        "    current_state = [random.randint(0, n - 1) for _ in range(n)]\n",
        "    current_cost = calculate_cost(current_state)\n",
        "    temp = initial_temp\n",
        "\n",
        "    print(f\"Initial State: {current_state} | Initial Cost: {current_cost}\\n\" + \"-\"*50)\n",
        "\n",
        "    for iteration in range(1, max_iterations + 1):\n",
        "        if current_cost == 0:\n",
        "            print(f\"Goal state reached at iteration {iteration}!\")\n",
        "            return current_state\n",
        "\n",
        "        neighbor = get_random_neighbor(current_state)\n",
        "        neighbor_cost = calculate_cost(neighbor)\n",
        "        delta_e = neighbor_cost - current_cost\n",
        "\n",
        "        if delta_e < 0 or random.random() < math.exp(-delta_e / temp):\n",
        "            current_state = neighbor\n",
        "            current_cost = neighbor_cost\n",
        "\n",
        "        temp *= cooling_rate\n",
        "        if temp < 1e-8:\n",
        "            temp = 1e-8\n",
        "\n",
        "    print(\"Max iterations reached without finding an optimal solution.\")\n",
        "    return current_state\n",
        "\n",
        "def print_board(state):\n",
        "    n = len(state)\n",
        "    for row in range(n):\n",
        "        line = \"\"\n",
        "        for col in range(n):\n",
        "            if state[col] == row:\n",
        "                line += \" Q \"\n",
        "            else:\n",
        "                line += \" . \"\n",
        "        print(line)\n",
        "\n",
        "solution = simulated_annealing(n=8)\n",
        "print(f\"\\nFinal State: {solution}\")\n",
        "print(f\"Final Cost (Attacking Pairs): {calculate_cost(solution)}\\n\")\n",
        "print_board(solution)"
        "print("ATHMIKA_1WN24CS055")"
      ]
